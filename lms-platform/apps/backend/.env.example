# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://pai_user:pai_password@localhost:5432/pai_lms?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# S3 / Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=xxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxx
S3_BUCKET_NAME=pai-lms-assets

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@paii.ca
EMAIL_FROM_NAME=Professional Artificial Intelligence Institute

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Admin
SUPER_ADMIN_EMAIL=admin@paii.ca
SUPER_ADMIN_PASSWORD=change_me_before_seed

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Proctoring photo retention (days) — biometric data, confirm the real
# retention period with legal/compliance before relying on the default.
STUDENT_PHOTO_RETENTION_DAYS=30

# Error tracking (optional) — leave unset to disable. Requires `npm install @sentry/node`.
SENTRY_DSN=

# In-browser code labs (E2B sandboxed execution) — can also be set from the
# admin UI (Settings → API Integrations → Labs), which takes priority over
# this env var. Leave both unset to disable the labs feature (endpoints will
# return a clear "not configured" error rather than fail confusingly).
# Get a key at https://e2b.dev.
E2B_API_KEY=
# Leave blank to use E2B's default Code Interpreter template (Python +
# numpy/pandas/sklearn preinstalled). Set this to a custom template ID once a
# template with torch/tensorflow-cpu/opencv/gym preinstalled is built and
# published. Do NOT set this to "base" — that's a bare-Ubuntu template with no
# code-interpreter server, and runCode() will fail against it.
E2B_TEMPLATE=
