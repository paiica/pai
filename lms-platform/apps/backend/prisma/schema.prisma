generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["lms"]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  super_admin
  admin
  professor
  student
  sales_rep
  org_admin

  @@schema("lms")
}

enum LabSessionStatus {
  starting
  running
  idle
  expired
  terminated

  @@schema("lms")
}

enum AffiliateStatus {
  pending
  approved
  suspended

  @@schema("lms")
}

enum AffiliateCommissionStatus {
  pending
  approved
  paid
  voided

  @@schema("lms")
}

enum AffiliateLeadStatus {
  invited
  registered
  logged_in
  purchased

  @@schema("lms")
}

enum AffiliateInviteStatus {
  pending
  registered
  converted

  @@schema("lms")
}

enum ApplicationStatus {
  pending_payment
  payment_submitted
  pending_review
  approved
  rejected
  withdrawn

  @@schema("lms")
}

enum EnrollmentStatus {
  active
  completed
  suspended
  expired
  registration_expired
  retake_expired

  @@schema("lms")
}

enum LessonType {
  video
  reading
  quiz
  assignment
  live_session
  download
  html

  @@schema("lms")
}

// Sublesson classification (Lesson.sublesson_kind) — separate from the
// technical LessonType above, which stays "reading" for every sublesson
// since they go through the same rich-text/blocks content system. This is
// the author-facing "what kind of supporting content is this" label shown
// in the course builder and as a badge when a student opens one.
enum SublessonKind {
  explanation
  instructions
  example
  tip
  case_study
  how_to
  resource
  other

  @@schema("lms")
}

// How a Sublesson's contextual link opens for a student — see
// Lesson.open_behavior.
enum SublessonOpenBehavior {
  same_page
  modal
  dedicated

  @@schema("lms")
}

enum QuestionType {
  multiple_choice
  true_false
  short_answer

  @@schema("lms")
}

enum SubmissionStatus {
  submitted
  under_review
  graded
  returned

  @@schema("lms")
}

enum ExamAttemptStatus {
  in_progress
  passed
  failed
  abandoned

  @@schema("lms")
}

enum CertificateStatus {
  active
  expired
  lapsed
  revoked
  suspended

  @@schema("lms")
}

enum ExternalPduStatus {
  pending
  approved
  rejected

  @@schema("lms")
}

enum ExamStatus {
  draft
  published
  archived

  @@schema("lms")
}

enum ExamQuestionType {
  mcq_single
  mcq_multiple
  true_false
  open_short
  open_long
  essay
  fill_blank
  matching
  ordering
  dropdown
  code
  html

  @@schema("lms")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded

  @@schema("lms")
}

enum PaymentType {
  enrollment
  retake_fee
  renewal_fee
  corporate_bundle
  event_registration
  program

  @@schema("lms")
}

enum EventType {
  online
  in_person
  hybrid

  @@schema("lms")
}

enum EventStatus {
  draft
  published
  cancelled
  completed

  @@schema("lms")
}

enum EventNature {
  training
  seminar
  workshop
  conference
  meetup
  webinar
  other

  @@schema("lms")
}

enum MeetingPlatform {
  zoom
  teams
  google_meet
  other

  @@schema("lms")
}

enum EventRegistrationStatus {
  registered
  cancelled

  @@schema("lms")
}

enum NotificationType {
  application_submitted
  application_approved
  application_rejected
  enrollment_created
  lesson_completed
  module_completed
  course_completed
  exam_passed
  exam_failed
  certificate_issued
  certificate_expiring
  payment_succeeded
  payment_failed
  assignment_submitted
  assignment_graded
  system_announcement
  course_invitation_received
  course_invitation_accepted
  course_invitation_rejected
  course_approved
  course_rejected
  certification_recommendation_received
  program_recommendation_received

  @@schema("lms")
}

enum CareerStatus {
  professional
  student
  other

  @@schema("lms")
}

enum CertificationLevel {
  pre_certificate
  foundation
  advanced
  executive
  specialist
  other

  @@schema("lms")
}

enum CertificationStatus {
  active
  archived
  coming_soon

  @@schema("lms")
}

enum CourseStatus {
  draft
  active
  archived

  @@schema("lms")
}

enum CourseApprovalStatus {
  none
  pending
  approved
  rejected

  @@schema("lms")
}

enum CourseLevel {
  beginner
  intermediate
  advanced

  @@schema("lms")
}

// ─────────────────────────────────────────────
// CORE IDENTITY
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  email_verified             Boolean   @default(false)
  email_verify_token            String?
  email_verify_token_expires_at DateTime?
  pending_email                 String?
  email_change_token_hash    String?   @unique
  email_change_expires_at    DateTime?
  password_hash              String
  pending_referral_code      String?
  role               Role      @default(student)
  is_active          Boolean   @default(true)
  // Distinct from the generic admin/super_admin role: the LMS admin role is
  // handed out for unrelated admin tasks (content, marketing, support), and
  // without this, every one of those accounts could also read every exam's
  // correct-answer keys via the exam-admin app. super_admin always bypasses
  // this check regardless of its value (see ExamAnswerAccessGuard).
  can_view_exam_answers Boolean @default(false)
  last_login_at      DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  // Set whenever the user gets an org-linked enrollment (bulk invite or
  // self-service join link) and deliberately left in place after an org
  // admin removes them — lets the admin panel show "Previously: Org X" even
  // once the live enrollment is gone, instead of an unexplained orphan.
  last_organization_id String?
  last_organization     Organization? @relation("UserLastOrganization", fields: [last_organization_id], references: [id])

  profile             Profile?
  refresh_tokens      RefreshToken[]
  applications        Application[]
  enrollments         Enrollment[]
  lesson_progress     LessonProgress[]
  lesson_notes        LessonNote[]
  exam_attempts       ExamAttempt[]
  certificates        Certificate[]
  payments            Payment[]
  notifications       Notification[]
  audit_logs          AuditLog[]
  professor_courses   CourseInstructor[]
  course_teaching     CourseTeacher[]
  course_enrollments  CourseEnrollment[]
  password_resets     PasswordReset[]
  uploaded_files      UploadedFile[]
  submissions              AssignmentSubmission[] @relation("student_submissions")
  graded_submissions       AssignmentSubmission[] @relation("graded_submissions")
  application_documents    ApplicationDocument[]
  exam_bookings            ExamBooking[]
  affiliate_profile        AffiliateProfile?
  organization_admin       OrganizationAdmin?
  affiliate_commissions_as_buyer AffiliateCommission[]
  affiliate_leads_referred AffiliateLead[]
  event_registrations      EventRegistration[]
  admin_permission         AdminPermission?
  cart_items               CartItem[]
  granted_course_waivers   EnrollmentCourseWaiver[] @relation("CourseWaiverGrantedBy")
  external_pdu_submissions ExternalPduSubmission[] @relation("ExternalPduSubmissions")
  reviewed_external_pdus   ExternalPduSubmission[] @relation("ExternalPduReviews")
  professor_students       ProfessorStudent[] @relation("ProfessorStudents")
  student_professors       ProfessorStudent[] @relation("StudentProfessors")
  invitations_sent         CourseInvitation[] @relation("ProfessorInvitationsSent")
  invitations_received     CourseInvitation[] @relation("StudentInvitationsReceived")
  courses_created          Course[] @relation("CourseCreatedBy")
  courses_reviewed         Course[] @relation("CourseReviewedBy")
  cert_recommendations_sent     CertificationRecommendation[] @relation("ProfessorCertRecommendationsSent")
  cert_recommendations_received CertificationRecommendation[] @relation("StudentCertRecommendationsReceived")
  programs_created         Program[] @relation("ProgramCreatedBy")
  programs_directed        Program[] @relation("ProgramDirector")
  program_enrollments      ProgramEnrollment[]
  program_certificates     ProgramCertificate[]
  transcripts              Transcript[]
  program_instructor_assignments ProgramInstructor[] @relation("ProgramInstructor")
  program_course_waivers_granted ProgramCourseWaiver[] @relation("ProgramCourseWaiverGrantedBy")
  program_recommendations_sent     ProgramRecommendation[] @relation("ProgramRecommendationsSent")
  program_recommendations_received ProgramRecommendation[] @relation("ProgramRecommendationsReceived")
  lab_sessions             LabSession[]

  @@index([email])
  @@map("users")
  @@schema("lms")
}

model AdminPermission {
  id         String   @id @default(uuid())
  user_id    String   @unique
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tabs       String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admin_permissions")
  @@schema("lms")
}

model Profile {
  id           String       @id @default(uuid())
  user_id      String       @unique
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  first_name   String
  last_name    String
  display_name String?
  avatar_url   String?
  bio          String?
  phone        String?
  date_of_birth DateTime?
  gender       String?
  country      String?
  timezone     String       @default("America/Toronto")
  language     String       @default("en")

  career_status    CareerStatus?
  job_title        String?
  company          String?
  industry         String?
  years_experience Int?
  linkedin_url     String?

  university      String?
  degree_program  String?
  graduation_year Int?

  nationality        String?
  pai_id             String?  @unique
  education_entries  Json     @default("[]")
  experience_entries Json     @default("[]")
  addresses          Json     @default("[]")
  resume_url         String?

  email_notifications Boolean @default(true)
  marketing_emails    Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("profiles")
  @@schema("lms")
}

model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash  String   @unique
  device_info String?
  ip_address  String?
  is_revoked  Boolean  @default(false)
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
  @@schema("lms")
}

model PasswordReset {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([token_hash])
  @@map("password_resets")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// CERTIFICATIONS & CURRICULUM
// ─────────────────────────────────────────────

model Certification {
  id                   String              @id @default(uuid())
  slug                 String              @unique
  acronym              String              @unique
  title                String
  level                CertificationLevel
  status               CertificationStatus @default(active)
  badge_icon           String              @default("graduation-cap")
  badge_image_url      String?
  price                Decimal             @db.Decimal(10, 2)
  stripe_price_id      String?

  description          String
  long_description     String
  learning_outcomes    String[]
  target_audience      String[]

  // Arabic marketing copy — empty means "not translated yet," public
  // endpoints fall back to the matching English field above.
  title_ar             String   @default("")
  description_ar       String   @default("")
  long_description_ar  String   @default("")
  learning_outcomes_ar String[] @default([])
  target_audience_ar   String[] @default([])
  skills_ar            String[] @default([])
  curriculum_overview_ar Json   @default("[]")
  faqs_json_ar           Json   @default("[]")

  // Per-locale translations, e.g. { "fr": { "title": "...", "description": "...",
  // "learning_outcomes": [...], "curriculum_overview": [...], ... } }.
  // Supersedes the *_ar fields above.
  translations Json @default("{}")

  duration_weeks        Int
  total_lessons         Int     @default(0)
  total_hours           Decimal @db.Decimal(5, 1) @default(0)
  passing_score         Int     @default(70)
  exam_duration_minutes Int     @default(90)
  exam_questions_count  Int     @default(75)
  validity_years        Int     @default(2)
  max_retakes_included  Int     @default(2)
  retake_fee            Decimal @db.Decimal(10, 2) @default(99.00)

  // How long a student has after registering to book and sit their exam
  // before they must register (and pay) again — distinct from validity_years,
  // which governs how long an already-issued certificate lasts before renewal.
  registration_validity_days Int @default(365)
  // How long a student has after failing an attempt to use their included
  // retake before it lapses and they must register again.
  retake_window_days         Int @default(60)

  renewal_pdu_required      Int     @default(0)
  renewal_window_days       Int     @default(90)
  renewal_grace_period_days Int     @default(180)
  renewal_fee               Decimal @db.Decimal(10, 2) @default(99.00)

  curriculum_overview     Json     @default("[]")
  faqs_json               Json     @default("[]")
  marketing_meta          Json     @default("{}")
  testimonials            Json     @default("[]")
  skills                  String[] @default([])
  related_slugs           String[] @default([])
  certificate_preview_url String   @default("")

  min_years_experience  Int?
  min_training_hours    Int?
  industry_focus        String[] @default([])
  required_education    String[] @default([])
  required_documents    String[] @default([])

  is_featured           Boolean  @default(false)
  // Highlighted with a teal border on the homepage's Featured Certifications
  // carousel — distinct from `is_featured` (which just controls inclusion in
  // that carousel at all) and from the unrelated "Most Popular" badge stored
  // in marketing_meta.is_most_popular.
  is_flagship           Boolean  @default(false)
  ai_professor_enabled  Boolean  @default(false)
  // Holders of this certification (an active/expired/lapsed Certificate, not
  // revoked) get this % off prep course purchases — the best discount among
  // all certifications a student holds is used, never stacked.
  member_discount_percentage Int @default(0)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  modules              Module[]
  applications         Application[]
  enrollments          Enrollment[]
  certificates         Certificate[]
  exam_banks           ExamBank[]
  exam_sessions        ExamSession[]
  instructors          CourseInstructor[]
  faqs                 CourseFAQ[]
  prep_courses         Course[]
  structured_exams     StructuredExam[]
  course_recommendations CourseCertRecommendation[]
  affiliate_assignments  AffiliateProductAssignment[]
  affiliate_leads        AffiliateLead[]
  affiliate_commissions  AffiliateCommission[]
  cart_items             CartItem[]
  professor_recommendations CertificationRecommendation[]

  @@index([slug])
  @@index([status])
  @@map("certifications")
  @@schema("lms")
}

model Module {
  id               String         @id @default(uuid())
  certification_id String?
  certification    Certification? @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  course_id        String?
  course           Course?        @relation(fields: [course_id], references: [id], onDelete: Cascade)

  title          String
  description    String?
  sort_order     Int
  duration_hours Decimal @db.Decimal(5, 1) @default(0)
  is_published   Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lessons Lesson[]

  @@index([certification_id, sort_order])
  @@index([course_id, sort_order])
  @@map("modules")
  @@schema("lms")
}

model Lesson {
  id        String @id @default(uuid())
  module_id String
  module    Module @relation(fields: [module_id], references: [id], onDelete: Cascade)

  title            String
  description      String?
  type             LessonType
  sort_order       Int
  duration_minutes Int     @default(10)
  is_published     Boolean @default(false)
  is_free_preview  Boolean @default(false)

  video_url          String?
  video_duration_sec Int?
  content_body       String?  @db.Text
  blocks_json        Json?
  // Runnable in-browser lab cells ({type:"markdown"|"code", content,
  // runnable?, skip_reason?}[]) — kept separate from blocks_json, which the
  // visual content-block editor (BlocksEditor) already owns for a different
  // cell shape. LabsService/LabPanel read this field exclusively.
  lab_cells_json     Json?
  download_url       String?
  allow_download     Boolean  @default(true)
  external_url       String?

  // Quiz settings
  passing_score      Int?    @default(70)
  max_attempts       Int?    @default(3)
  time_limit_minutes Int?

  // Assignment settings
  due_date             DateTime?
  max_score            Int?     @default(100)
  allow_text_response  Boolean  @default(true)
  text_word_limit      Int?
  // Assignment availability/submission-policy settings — additive, only
  // meaningful when type = "assignment". max_attempts (above, shared with
  // quizzes) is reused as the assignment's attempt cap rather than adding a
  // separate field.
  available_from           DateTime?
  accept_submissions       Boolean  @default(true)
  allow_late_submissions   Boolean  @default(false)
  late_submission_deadline DateTime?
  late_penalty_type        String?  // "none" | "percentage" | "points" — plain string, not an enum, so new types don't need a migration
  late_penalty_value       Float?
  allow_file_upload        Boolean  @default(true)
  max_files                Int?     @default(1)
  accepted_file_types      String[] @default([])
  max_file_size_mb         Int?     @default(10)
  // [{ criterion, description, points }] — reference table shown while
  // grading, never auto-summed into the grade (no grade-calculation
  // pipeline exists anywhere in this platform).
  rubric_json              Json?

  // Sublessons — a secondary/contextual content layer attached to a Lesson
  // (Module -> Lesson -> Sublesson), NOT a new item in the primary student
  // navigation. A Sublesson is a Lesson row like any other (same content
  // system, type stays "reading") with parent_lesson_id set and
  // visible_in_structure false, reached only via a contextual link the
  // instructor places inside the parent Lesson's content. onDelete: Cascade
  // so deleting a Lesson deletes its Sublessons rather than orphaning them.
  parent_lesson_id String?
  parent_lesson    Lesson?  @relation("LessonSublessons", fields: [parent_lesson_id], references: [id], onDelete: Cascade)
  sublessons       Lesson[] @relation("LessonSublessons")

  // Only meaningful when parent_lesson_id is set (i.e. this row is itself a
  // Sublesson) — defaults below match the product spec's stated defaults.
  sublesson_kind       SublessonKind?
  visible_in_structure Boolean                @default(true) // regular lessons stay true; the "Add Sublesson" flow sets this false on creation
  available_via_link   Boolean                @default(true)
  sublesson_required   Boolean                @default(false)
  track_views          Boolean                @default(true)
  open_behavior        SublessonOpenBehavior  @default(modal)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  progress                LessonProgress[]
  quiz_questions          QuizQuestion[]
  resources               LessonResource[]
  assignment_submissions  AssignmentSubmission[]
  uploaded_files          UploadedFile[]
  notes                   LessonNote[]
  lab_sessions            LabSession[]

  @@index([module_id, sort_order])
  @@index([parent_lesson_id])
  @@map("lessons")
  @@schema("lms")
}

// Instructor-attached downloadable resources for a lesson (e.g. an
// assignment's instructions PDF, dataset, template). Existed in the schema
// with zero backend/frontend code anywhere until this — same dead-field
// pattern as a few other fields discovered this session. Mirrors
// CourseDocument's CRUD shape exactly (sort_order, file_name, updated_at
// added here to match).
model LessonResource {
  id         String   @id @default(uuid())
  lesson_id  String
  lesson     Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  title      String
  url        String
  file_type  String?
  file_name  String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("lesson_resources")
  @@schema("lms")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  lesson_id     String
  lesson        Lesson       @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  question_text String
  question_type QuestionType @default(multiple_choice)
  options       Json
  correct_index Int
  explanation   String?
  points        Int          @default(1)
  sort_order    Int          @default(0)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@index([lesson_id])
  @@map("quiz_questions")
  @@schema("lms")
}

// Tracks one E2B sandbox per active in-browser lab session. Lesson.blocks_json
// holds the runnable notebook cells; this table is purely session/cost-control
// bookkeeping (idle cleanup job keys off last_active_at / expires_at) — never
// holds code or output, which live only inside the ephemeral sandbox itself.
model LabSession {
  id                 String            @id @default(uuid())
  user_id            String
  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson_id          String
  lesson             Lesson            @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  provider           String            @default("e2b")
  external_sandbox_id String?
  status             LabSessionStatus  @default(starting)

  started_at         DateTime          @default(now())
  last_active_at      DateTime          @default(now())
  expires_at          DateTime?
  ended_at            DateTime?

  @@index([user_id, status])
  @@index([status, last_active_at])
  @@map("lab_sessions")
  @@schema("lms")
}

model ExamBank {
  id               String        @id @default(uuid())
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  question_text    String
  options          Json
  correct_index    Int
  explanation      String?
  topic_tag        String?
  difficulty       Int     @default(2)
  is_active        Boolean @default(true)
  created_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([certification_id, is_active])
  @@map("exam_bank")
  @@schema("lms")
}

model CourseInstructor {
  id               String        @id @default(uuid())
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id])
  user_id          String
  user             User          @relation(fields: [user_id], references: [id])
  is_lead          Boolean  @default(false)
  assigned_at      DateTime @default(now())

  @@unique([certification_id, user_id])
  @@map("course_instructors")
  @@schema("lms")
}

model CourseFAQ {
  id               String        @id @default(uuid())
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  question         String
  answer           String
  sort_order       Int      @default(0)
  created_at       DateTime @default(now())

  @@map("course_faqs")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// STANDALONE COURSES (purchasable prep content)
// ─────────────────────────────────────────────

model Course {
  id                   String       @id @default(uuid())
  slug                 String       @unique
  title                String
  subtitle             String?
  description          String?

  // Arabic marketing copy — empty/null means "not translated yet," public
  // endpoints fall back to the matching English field above.
  title_ar             String?
  subtitle_ar          String?
  description_ar       String?
  content_ar           Json?

  // Per-locale translations, e.g. { "fr": { "title": "...", "subtitle": "...",
  // "description": "...", "content": {...same shape as content...} } }.
  // Supersedes the *_ar fields above.
  translations Json @default("{}")

  price                Decimal      @db.Decimal(10, 2) @default(0)
  // Crossed-out "was" price shown next to `price` for a promo (e.g. Launch
  // Pricing) — null means no promo, the card just shows `price` plain.
  compare_at_price     Decimal?     @db.Decimal(10, 2)
  status               CourseStatus @default(draft)
  thumbnail_url        String?
  preview_video_url    String?
  level                CourseLevel  @default(beginner)
  duration_hours       Decimal      @db.Decimal(5, 1) @default(0)
  pdu_value            Decimal      @db.Decimal(5, 1) @default(0)
  total_lessons        Int          @default(0)
  // Gates the on-demand course completion certificate (see LearningService.
  // getCourseCertificate) — a student must average at least this % across
  // the course's graded assignments (courses with no graded items pass on
  // completion alone).
  passing_score        Int?         @default(70)

  // Marketing content shown on the public course detail page (overview,
  // learning outcomes, how-it-works steps, exam prep, related courses)
  content              Json?

  // Optional link to the certification this course prepares for
  certification_id     String?
  certification        Certification? @relation(fields: [certification_id], references: [id], onDelete: SetNull)

  is_featured  Boolean  @default(false)
  ai_professor_enabled Boolean @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Professor-authored courses only — null/default values below leave every
  // existing admin-created course completely untouched. `status` (above)
  // still governs whether the course is enrollable at all; `is_listed` is a
  // SEPARATE gate for the public catalog specifically, so a private/
  // unapproved professor course can be `status: active` (shareable via
  // invitation the moment it's created) while staying out of public
  // listings until an admin approves it — see prep-courses.service.ts's
  // findAll/findFeatured for where is_listed is enforced.
  created_by       String?
  creator          User?    @relation("CourseCreatedBy", fields: [created_by], references: [id])
  created_by_role  Role?
  approval_status  CourseApprovalStatus @default(none)
  is_listed        Boolean  @default(true)
  rejection_reason String?
  submitted_at     DateTime?
  reviewed_at      DateTime?
  reviewed_by      String?
  reviewer         User?    @relation("CourseReviewedBy", fields: [reviewed_by], references: [id])

  modules          Module[]
  instructors      CourseTeacher[]
  enrollments      CourseEnrollment[]
  cert_recommendations CourseCertRecommendation[]
  affiliate_assignments  AffiliateProductAssignment[]
  affiliate_leads        AffiliateLead[]
  affiliate_commissions  AffiliateCommission[]
  documents        CourseDocument[]
  cart_items       CartItem[]
  invitations      CourseInvitation[]

  // Prerequisites/co-requisites — self-referential. `prerequisites` = rows
  // where this course is the one being gated ("this course requires X");
  // `required_for` = rows where this course is the one doing the gating.
  prerequisites    CoursePrerequisite[] @relation("CourseHasPrereqs")
  required_for     CoursePrerequisite[] @relation("CourseIsPrereqFor")

  enrollment_waivers EnrollmentCourseWaiver[]
  program_courses    ProgramCourse[]
  program_course_waivers ProgramCourseWaiver[]

  @@index([slug])
  @@index([status])
  @@map("courses")
  @@schema("lms")
}

// Downloadable materials (syllabus, outline, etc.) attached to a course.
// Shown publicly on the course's marketing page so prospective students can
// preview them before enrolling — not gated behind enrollment/lesson access.
model CourseDocument {
  id        String @id @default(uuid())
  course_id String
  course    Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  title      String
  file_url   String
  file_name  String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([course_id, sort_order])
  @@map("course_documents")
  @@schema("lms")
}

model CourseTeacher {
  id          String   @id @default(uuid())
  course_id   String
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  is_lead     Boolean  @default(false)
  assigned_at DateTime @default(now())

  @@unique([course_id, user_id])
  @@map("course_teachers")
  @@schema("lms")
}

// Many-to-many: a student can belong to multiple professors' rosters, and a
// professor's roster is distinct from actual course enrollment — being on
// this list just means the professor can invite this student to courses,
// nothing more. `status` lets a professor remove someone from their roster
// (Remove Student Association) without touching the student's own account
// or their past invitation history, which still references student_id
// directly rather than through this row.
model ProfessorStudent {
  id           String                 @id @default(uuid())
  professor_id String
  professor    User                   @relation("ProfessorStudents", fields: [professor_id], references: [id], onDelete: Cascade)
  student_id   String
  student      User                   @relation("StudentProfessors", fields: [student_id], references: [id], onDelete: Cascade)
  status       ProfessorStudentStatus @default(active)
  created_at   DateTime               @default(now())

  @@unique([professor_id, student_id])
  @@map("professor_students")
  @@schema("lms")
}

enum ProfessorStudentStatus {
  active
  removed

  @@schema("lms")
}

// A professor sharing a Course with one of their students. Deliberately
// Course-only for now — Certification enrollment already goes through the
// Application/admin-review gate even on a $0 purchase, a materially
// different flow than this one; adding that as a second invitation type is
// a natural follow-up once this is proven, not part of this pass.
//
// No hard DB uniqueness on (professor_id, student_id, course_id): enforced
// in the service layer instead, since "resend after rejection" needs to
// reset an existing row back to pending rather than fail on a duplicate.
model CourseInvitation {
  id               String                 @id @default(uuid())
  professor_id     String
  professor        User                   @relation("ProfessorInvitationsSent", fields: [professor_id], references: [id], onDelete: Cascade)
  student_id       String
  student          User                   @relation("StudentInvitationsReceived", fields: [student_id], references: [id], onDelete: Cascade)
  course_id        String
  course           Course                 @relation(fields: [course_id], references: [id], onDelete: Cascade)

  status           CourseInvitationStatus @default(pending)
  invited_at       DateTime               @default(now())
  responded_at     DateTime?
  rejection_reason String?
  // null = free course (n/a); "pending" = paid, awaiting checkout; "paid" = paid and confirmed
  payment_status   String?
  // true when the professor doesn't teach this course (browsed the public
  // catalog and recommended it) — false for invitations to a course they teach
  is_recommendation Boolean @default(false)
  // Set to the resulting CourseEnrollment.id once accept succeeds (free path immediately, paid path after webhook fulfillment)
  enrollment_id    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([student_id, status])
  @@index([professor_id, course_id])
  @@map("course_invitations")
  @@schema("lms")
}

// A professor pointing a student at one of PAII's accredited certifications.
// Unlike CourseInvitation, there's no accept/reject/enrollment state here —
// certification enrollment always requires the student to independently
// complete the admin-reviewed Application flow (applications.service.ts),
// so "recommending" can't itself produce an enrollment. This is purely an
// informational, idempotent record used to notify/email the student.
model CertificationRecommendation {
  id               String        @id @default(uuid())
  professor_id     String
  professor        User          @relation("ProfessorCertRecommendationsSent", fields: [professor_id], references: [id], onDelete: Cascade)
  student_id       String
  student          User          @relation("StudentCertRecommendationsReceived", fields: [student_id], references: [id], onDelete: Cascade)
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([professor_id, student_id, certification_id])
  @@index([student_id])
  @@map("certification_recommendations")
  @@schema("lms")
}

enum CourseInvitationStatus {
  pending
  accepted
  rejected

  @@schema("lms")
}

model CourseEnrollment {
  id                  String   @id @default(uuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course_id           String
  course              Course   @relation(fields: [course_id], references: [id])
  progress_percentage Int      @default(0)
  enrolled_at         DateTime @default(now())
  completed_at        DateTime?

  stripe_payment_intent_id   String?
  amount_paid                Decimal? @db.Decimal(10, 2)

  assignment_submissions AssignmentSubmission[]
  lesson_progress        LessonProgress[]

  @@unique([user_id, course_id])
  @@index([user_id])
  @@index([course_id])
  @@map("course_enrollments")
  @@schema("lms")
}

model CourseCertRecommendation {
  course_id        String
  course           Course        @relation(fields: [course_id], references: [id], onDelete: Cascade)
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id], onDelete: Cascade)

  // When true, this course must be completed before the student can book/
  // start the certification exam — set from the certification editor's
  // "required" toggle, distinct from merely being "related"/recommended.
  is_required      Boolean       @default(false)

  // Only meaningful when is_required is true: whether this course is
  // bundled free with certification enrollment (content merges directly
  // into the certification's own player, no purchase needed) or must be
  // bought separately like any other standalone course.
  is_free          Boolean       @default(false)

  @@id([course_id, certification_id])
  @@map("course_cert_recommendations")
  @@schema("lms")
}

// Account-level shopping cart. Persisted server-side (not localStorage) so
// items added from the marketing site and the student portal — two separate
// origins — both read/write the same cart for a logged-in user.
model CartItem {
  id               String         @id @default(uuid())
  user_id          String
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type             String         // "course" | "certification"
  course_id        String?
  course           Course?        @relation(fields: [course_id], references: [id], onDelete: Cascade)
  certification_id String?
  certification    Certification? @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  created_at       DateTime       @default(now())

  @@unique([user_id, course_id])
  @@unique([user_id, certification_id])
  @@index([user_id])
  @@map("cart_items")
  @@schema("lms")
}

enum CoursePrerequisiteType {
  prerequisite
  corequisite

  @@schema("lms")
}

// Self-referential many-to-many on Course. `type: prerequisite` is enforced
// at enrollment time (course_id can't be enrolled in until
// prerequisite_course_id shows a completed CourseEnrollment).
// `type: corequisite` is informational only — "take together" — and is not
// gated.
model CoursePrerequisite {
  course_id              String
  course                 Course                 @relation("CourseHasPrereqs", fields: [course_id], references: [id], onDelete: Cascade)
  prerequisite_course_id String
  prerequisite_course    Course                 @relation("CourseIsPrereqFor", fields: [prerequisite_course_id], references: [id], onDelete: Cascade)
  type                   CoursePrerequisiteType @default(prerequisite)
  created_at             DateTime               @default(now())

  @@id([course_id, prerequisite_course_id])
  @@map("course_prerequisites")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// FILE UPLOADS
// ─────────────────────────────────────────────

model UploadedFile {
  id            String  @id @default(uuid())
  owner_id      String
  owner         User    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  lesson_id     String?
  lesson        Lesson? @relation(fields: [lesson_id], references: [id], onDelete: SetNull)

  filename      String
  original_name String
  size          Int
  mime_type     String
  s3_key        String
  url           String
  purpose       String  @default("content")

  created_at    DateTime @default(now())

  @@index([owner_id])
  @@index([lesson_id])
  @@map("uploaded_files")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// APPLICATIONS
// ─────────────────────────────────────────────

model Application {
  id               String            @id @default(uuid())
  user_id          String
  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  certification_id String
  certification    Certification     @relation(fields: [certification_id], references: [id])
  status           ApplicationStatus @default(pending_payment)

  full_name       String
  email           String
  phone           String?
  date_of_birth   DateTime?
  gender          String?
  country         String?
  career_status   CareerStatus?
  job_title       String?
  company         String?
  years_experience Int?
  training_hours  Int?
  linkedin_url    String?
  university      String?
  degree_program  String?
  graduation_year Int?
  motivation      String?
  how_heard       String?

  education_entries  Json     @default("[]")
  experience_entries Json     @default("[]")

  documents_requested       Boolean   @default(false)
  documents_request_message String?
  documents_requested_at    DateTime?

  // Set automatically at submission when the applicant doesn't meet the
  // certification's min_years_experience/min_training_hours — no longer
  // auto-rejected, just flagged so a reviewer can decide manually.
  eligibility_flagged      Boolean @default(false)
  eligibility_flag_reason  String?

  stripe_payment_intent_id   String?
  stripe_checkout_session_id String?
  amount_paid                Decimal?      @db.Decimal(10, 2)
  payment_status             PaymentStatus @default(pending)
  paid_at                    DateTime?
  promo_code                 String?

  reviewed_by      String?
  reviewed_at      DateTime?
  rejection_reason String?

  stripe_refund_id String?
  refunded_at      DateTime?
  refund_amount    Decimal? @db.Decimal(10, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  enrollment Enrollment?
  documents  ApplicationDocument[]

  @@unique([user_id, certification_id])
  @@index([status])
  @@index([user_id])
  @@map("applications")
  @@schema("lms")
}

model ApplicationDocument {
  id             String      @id @default(uuid())
  application_id String
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  file_url      String
  s3_key        String
  file_name     String
  mime_type     String?
  file_size     Int?
  uploaded_at   DateTime @default(now())

  @@index([application_id])
  @@map("application_documents")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// ENROLLMENTS & PROGRESS
// ─────────────────────────────────────────────

model Enrollment {
  id               String           @id @default(uuid())
  user_id          String
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  certification_id String
  certification    Certification    @relation(fields: [certification_id], references: [id])
  application_id   String?          @unique
  application      Application?     @relation(fields: [application_id], references: [id])
  status           EnrollmentStatus @default(active)
  progress_percentage Int           @default(0)
  enrolled_at      DateTime         @default(now())
  completed_at     DateTime?
  expires_at       DateTime?
  last_accessed_at DateTime?
  // Number of retake fees this student has successfully paid — each paid
  // retake unlocks one additional exam attempt beyond the original (free)
  // attempt, up to the certification's max_retakes_included cap.
  paid_retakes     Int              @default(0)
  // Set only when this enrollment was created through an org admin's
  // bulk-invite flow — null for individual checkout/application
  // enrollments. Lets an org admin's dashboard query "all of my org's
  // enrollments" without touching unrelated individual students' data.
  organization_id  String?
  organization     Organization?    @relation(fields: [organization_id], references: [id])

  lesson_progress         LessonProgress[]
  exam_attempts           ExamAttempt[]
  exam_bookings           ExamBooking[]
  certificate             Certificate?
  assignment_submissions  AssignmentSubmission[]
  course_waivers          EnrollmentCourseWaiver[]

  @@unique([user_id, certification_id])
  @@index([user_id])
  @@index([certification_id])
  @@index([organization_id])
  @@map("enrollments")
  @@schema("lms")
}

// Per-student, per-required-course exemption from the exam-booking
// prerequisites in ExamsService.startExam() — lets an admin waive the
// "must purchase" and "must complete" checks for one specific required
// course on one specific certification enrollment, without touching the
// requirement for any other student or any other required course.
model EnrollmentCourseWaiver {
  id             String     @id @default(uuid())
  enrollment_id  String
  enrollment     Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  course_id      String
  course         Course     @relation(fields: [course_id], references: [id], onDelete: Cascade)
  reason         String?    @db.Text
  waived_by      String
  waived_by_user User       @relation("CourseWaiverGrantedBy", fields: [waived_by], references: [id])
  waived_at      DateTime   @default(now())

  @@unique([enrollment_id, course_id])
  @@map("enrollment_course_waivers")
  @@schema("lms")
}

model LessonProgress {
  id                    String            @id @default(uuid())
  user_id               String
  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollment_id         String?
  enrollment            Enrollment?       @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  course_enrollment_id  String?
  course_enrollment     CourseEnrollment? @relation(fields: [course_enrollment_id], references: [id], onDelete: Cascade)
  lesson_id     String
  lesson        Lesson     @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  completed     Boolean    @default(false)
  completed_at  DateTime?
  watch_seconds Int        @default(0)
  quiz_score    Int?
  quiz_passed   Boolean?
  quiz_attempts Int        @default(0)
  last_position Int        @default(0)
  scorm_data    Json?
  started_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  @@unique([user_id, lesson_id])
  @@index([enrollment_id])
  @@index([course_enrollment_id])
  @@map("lesson_progress")
  @@schema("lms")
}

// A student's private, personal notes for a lesson — one per user per
// lesson, editable, not visible to anyone else (no instructor/admin read
// path exists for these on purpose).
model LessonNote {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson_id  String
  lesson     Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, lesson_id])
  @@map("lesson_notes")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// ASSIGNMENT SUBMISSIONS
// ─────────────────────────────────────────────

model AssignmentSubmission {
  id            String           @id @default(uuid())
  lesson_id     String
  lesson        Lesson           @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  user_id       String
  user          User             @relation("student_submissions", fields: [user_id], references: [id], onDelete: Cascade)
  enrollment_id String?
  enrollment    Enrollment?      @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  course_enrollment_id String?
  course_enrollment    CourseEnrollment? @relation(fields: [course_enrollment_id], references: [id], onDelete: Cascade)

  file_url      String?
  file_name     String?
  file_size     Int?
  text_content  String?          @db.Text
  attempt_count Int              @default(1)
  // Explicit, stable attempt number — replaces relying on attempt_count on a
  // mutated row. Every submit now creates a NEW row instead of overwriting
  // the previous one, so attempt history is preserved (never deleted).
  attempt_number Int             @default(1)
  // Denormalized "is this the current attempt" flag — set true on create,
  // false on all prior rows for the same (lesson_id, user_id) in the same
  // transaction. Lets every "current attempt" query (gradebook, course
  // completion, transcript grade calc) stay a cheap indexed lookup instead
  // of a window function.
  is_latest      Boolean         @default(true)
  // Computed once at submit time from the lesson's due_date/late window and
  // stored — not recomputed later, so editing a due date after the fact
  // doesn't retroactively relabel history.
  is_late        Boolean         @default(false)
  files          AssignmentSubmissionFile[]

  status        SubmissionStatus @default(submitted)
  submitted_at  DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  grade         Float?
  max_grade     Float            @default(100)
  feedback      String?          @db.Text
  graded_by     String?
  grader        User?            @relation("graded_submissions", fields: [graded_by], references: [id], onDelete: SetNull)
  graded_at     DateTime?

  @@index([lesson_id, user_id, is_latest])
  @@index([enrollment_id])
  @@index([course_enrollment_id])
  @@index([lesson_id])
  @@map("assignment_submissions")
  @@schema("lms")
}

// Additional files beyond the first for a multi-file assignment submission —
// the first file stays on AssignmentSubmission.file_url/file_name/file_size
// for backward compatibility, this table holds any files beyond that one.
model AssignmentSubmissionFile {
  id            String               @id @default(uuid())
  submission_id String
  submission    AssignmentSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  file_url      String
  file_name     String
  file_size     Int?
  created_at    DateTime             @default(now())

  @@map("assignment_submission_files")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// EXAMS & CERTIFICATES
// ─────────────────────────────────────────────

model ExamAttempt {
  id            String            @id @default(uuid())
  user_id       String
  user          User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollment_id String
  enrollment    Enrollment        @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  attempt_number Int              @default(1)
  status        ExamAttemptStatus @default(in_progress)

  started_at         DateTime @default(now())
  submitted_at       DateTime?
  time_limit_seconds Int?
  time_used_seconds  Int?

  total_questions  Int
  correct_answers  Int     @default(0)
  score_percentage Decimal? @db.Decimal(5, 2)
  passing_score    Int
  passed           Boolean?

  answers            Json?
  // Debounced client-side autosave of the student's in-progress selections
  // (question_id -> selected option index) while status is still
  // in_progress — lets the exam room restore their picks after a crash/
  // disconnect instead of only ever persisting on final submit. Distinct
  // from `answers`, which holds the frozen question set (and, once
  // submitted, the final graded answers) — this field is scratch space
  // only and is never read for grading.
  in_progress_answers Json?
  topic_breakdown    Json?
  proctor_session_id String?

  // Audit trail for admin score overrides — a certification-issuing action,
  // so who did it, when, and why must be recoverable after the fact.
  overridden_by   String?
  overridden_at   DateTime?
  override_reason String?   @db.Text

  created_at DateTime @default(now())

  attempt_sections ExamAttemptSection[]
  student_answers  StudentAnswer[]

  @@index([enrollment_id])
  @@index([user_id])
  @@map("exam_attempts")
  @@schema("lms")
}

model ExamSession {
  id               String        @id @default(uuid())
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  structured_exam_id String?
  structured_exam    StructuredExam? @relation(fields: [structured_exam_id], references: [id], onDelete: SetNull)
  title            String?
  scheduled_at     DateTime
  duration_minutes Int           @default(90)
  max_seats        Int?
  meeting_link              String?
  notes                     String?
  is_active                 Boolean  @default(true)
  allow_late_cancellation   Boolean  @default(false)
  created_by                String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  bookings ExamBooking[]

  @@index([certification_id])
  @@index([scheduled_at])
  @@map("exam_sessions")
  @@schema("lms")
}

model ExamBooking {
  id              String      @id @default(uuid())
  user_id         String
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exam_session_id String
  exam_session    ExamSession @relation(fields: [exam_session_id], references: [id], onDelete: Cascade)
  enrollment_id   String
  enrollment      Enrollment  @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  status          String      @default("confirmed")
  booked_at       DateTime    @default(now())
  cancelled_at    DateTime?

  @@unique([user_id, exam_session_id])
  @@index([user_id])
  @@index([exam_session_id])
  @@map("exam_bookings")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// STRUCTURED EXAM SYSTEM
// ─────────────────────────────────────────────

model StructuredExam {
  id               String        @id @default(uuid())
  certification_id String
  certification    Certification @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           ExamStatus    @default(draft)
  version          String?
  passing_score    Int           @default(70)
  created_by       String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  sections      ExamSection[]
  exam_sessions ExamSession[]

  @@index([certification_id])
  @@map("structured_exams")
  @@schema("lms")
}

model ExamSection {
  id                 String         @id @default(uuid())
  exam_id            String
  exam               StructuredExam @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  title              String
  description        String?
  sort_order         Int            @default(0)
  time_limit_minutes Int?
  instructions       String?        @db.Text
  is_required        Boolean        @default(true)
  passing_score      Int            @default(70)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  questions         ExamQuestion[]
  instruction_pages SectionInstructionPage[]
  attempt_sections  ExamAttemptSection[]

  @@index([exam_id, sort_order])
  @@map("exam_sections")
  @@schema("lms")
}

model SectionInstructionPage {
  id         String      @id @default(uuid())
  section_id String
  section    ExamSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  title      String?
  content    String      @db.Text
  sort_order Int         @default(0)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@index([section_id])
  @@map("section_instruction_pages")
  @@schema("lms")
}

model ExamQuestion {
  id            String           @id @default(uuid())
  section_id    String
  section       ExamSection      @relation(fields: [section_id], references: [id], onDelete: Cascade)
  type          ExamQuestionType @default(mcq_single)
  question_text String           @db.Text
  explanation   String?          @db.Text
  points        Int              @default(1)
  sort_order    Int              @default(0)
  is_required   Boolean          @default(true)
  metadata      Json?
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  options QuestionOption[]
  images  QuestionImage[]
  answers StudentAnswer[]

  @@index([section_id, sort_order])
  @@map("exam_questions")
  @@schema("lms")
}

model QuestionOption {
  id          String       @id @default(uuid())
  question_id String
  question    ExamQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  text        String
  is_correct  Boolean      @default(false)
  sort_order  Int          @default(0)
  match_text  String?

  @@index([question_id])
  @@map("question_options")
  @@schema("lms")
}

model QuestionImage {
  id          String       @id @default(uuid())
  question_id String
  question    ExamQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  url         String
  alt_text    String?
  caption     String?
  sort_order  Int          @default(0)
  created_at  DateTime     @default(now())

  @@index([question_id])
  @@map("question_images")
  @@schema("lms")
}

model ExamAttemptSection {
  id                String      @id @default(uuid())
  attempt_id        String
  attempt           ExamAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  section_id        String
  section           ExamSection @relation(fields: [section_id], references: [id])
  status            String      @default("not_started")
  started_at        DateTime?
  submitted_at      DateTime?
  time_used_seconds Int?

  @@unique([attempt_id, section_id])
  @@index([attempt_id])
  @@map("attempt_sections")
  @@schema("lms")
}

model StudentAnswer {
  id                  String       @id @default(uuid())
  attempt_id          String
  attempt             ExamAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question_id         String
  question            ExamQuestion @relation(fields: [question_id], references: [id])
  selected_option_ids Json?
  answer_text         String?      @db.Text
  answer_json         Json?
  is_correct          Boolean?
  points_awarded      Int?
  answered_at         DateTime     @default(now())

  @@unique([attempt_id, question_id])
  @@index([attempt_id])
  @@map("student_answers")
  @@schema("lms")
}

// Admin-enabled content languages, sourced from a curated SUPPORTED_LANGUAGES
// list in code (see ai/supported-languages.ts) — the admin can only enable a
// language from that list, not type an arbitrary code. "en" is seeded
// enabled and is never disabled/removed since it's the source language every
// translation is generated from.
model Language {
  code        String   @id
  name        String
  native_name String
  is_rtl      Boolean  @default(false)
  enabled     Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("languages")
  @@schema("lms")
}

model SiteSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("site_settings")
  @@schema("lms")
}

model Certificate {
  id               String            @id @default(uuid())
  user_id          String
  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollment_id    String            @unique
  enrollment       Enrollment        @relation(fields: [enrollment_id], references: [id])
  certification_id String
  certification    Certification     @relation(fields: [certification_id], references: [id])

  certificate_number    String            @unique
  status                CertificateStatus @default(active)

  holder_name           String
  certification_title   String
  certification_acronym String
  exam_score            Decimal @db.Decimal(5, 2)

  issued_at         DateTime  @default(now())
  expires_at        DateTime
  revoked_at        DateTime?
  revocation_reason String?

  verification_url  String
  qr_code_url       String?
  pdf_url           String?
  badge_url         String?

  linkedin_added    Boolean  @default(false)
  linkedin_added_at DateTime?

  renewed_at                       DateTime?
  renewal_count                    Int       @default(0)
  renewal_stripe_payment_intent_id String?
  renewal_amount_paid              Decimal?  @db.Decimal(10, 2)
  last_renewal_reminder_days_out   Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  external_pdu_submissions ExternalPduSubmission[]

  @@index([certificate_number])
  @@index([user_id])
  @@map("certificates")
  @@schema("lms")
}

// Student-submitted external professional-development activity (a
// conference, another provider's course, work experience, etc.) claimed
// toward a certificate's PDU renewal requirement. Sits pending until an
// admin reviews it and sets the actual PDU value — `requested_pdu_value`
// is only the student's own suggestion, never counted until approved.
// `certification_id` is denormalized from `certificate.certification_id`
// purely so PDU-total queries don't need to join through Certificate.
model ExternalPduSubmission {
  id                String      @id @default(uuid())
  user_id           String
  user              User        @relation("ExternalPduSubmissions", fields: [user_id], references: [id], onDelete: Cascade)
  certificate_id    String
  certificate       Certificate @relation(fields: [certificate_id], references: [id], onDelete: Cascade)
  certification_id  String

  title               String
  provider            String?
  description         String?  @db.Text
  activity_date       DateTime
  proof_url           String?
  requested_pdu_value Decimal? @db.Decimal(5, 2)

  status            ExternalPduStatus @default(pending)
  awarded_pdu_value Decimal?          @db.Decimal(5, 2)
  reviewed_by       String?
  reviewer          User?             @relation("ExternalPduReviews", fields: [reviewed_by], references: [id])
  reviewed_at       DateTime?
  rejection_reason  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([certificate_id])
  @@index([status])
  @@map("external_pdu_submissions")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id      String @id @default(uuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type    PaymentType
  status  PaymentStatus @default(pending)

  // Set only for org seat-purchase/renewal payments (type: corporate_bundle
  // via those flows) — null for individual student payments.
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  stripe_payment_intent_id   String? @unique
  stripe_checkout_session_id String?
  stripe_charge_id           String?
  stripe_receipt_url         String?

  description String?
  metadata    Json?

  refund_amount    Decimal? @db.Decimal(10, 2)
  stripe_refund_id String?
  refunded_at      DateTime?

  succeeded_at   DateTime?
  failed_at      DateTime?
  failure_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([status])
  @@map("payments")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id      String           @id @default(uuid())
  user_id String
  user    User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  body    String
  data    Json?
  read    Boolean  @default(false)
  read_at DateTime?
  created_at DateTime @default(now())

  @@index([user_id, read])
  @@map("notifications")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// AUDIT & SYSTEM
// ─────────────────────────────────────────────

model AuditLog {
  id          String  @id @default(uuid())
  user_id     String?
  user        User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String
  entity_type String?
  entity_id   String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
  @@schema("lms")
}

model SystemConfig {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  description String?
  updated_by  String?
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  @@map("system_config")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// CMS — PAGE BLOCKS & NAVIGATION
// ─────────────────────────────────────────────

model PageBlock {
  key          String   @id
  label        String
  is_visible   Boolean  @default(true)
  content      Json     @default("{}")
  // Arabic content, mirroring the shape of `content` field-for-field —
  // empty/missing keys fall back to the English `content` value.
  content_ar   Json     @default("{}")
  // Per-locale translations of `content`, e.g. { "fr": { ...same shape as content... } }.
  translations Json     @default("{}")
  sort_order   Int      @default(0)
  updated_at   DateTime @updatedAt

  @@map("page_blocks")
  @@schema("lms")
}

model NavItem {
  id           String    @id @default(uuid())
  label        String
  label_ar     String    @default("")
  // Per-locale translations, e.g. { "fr": { "label": "..." } }.
  translations Json      @default("{}")
  href         String
  sort_order   Int       @default(0)
  is_visible   Boolean   @default(true)
  open_new_tab Boolean   @default(false)
  parent_id    String?
  parent       NavItem?  @relation("NavItemChildren", fields: [parent_id], references: [id], onDelete: Cascade)
  children     NavItem[] @relation("NavItemChildren")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([parent_id])
  @@map("nav_items")
  @@schema("lms")
}

model Page {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  content          String   @default("")
  meta_description String   @default("")
  is_published     Boolean  @default(false)

  // Arabic counterparts — nullable/empty-default siblings, never restructured
  // around a generic locale system, so existing English-only rows are
  // completely unaffected. Empty means "not translated yet"; the public
  // endpoint falls back to the English field in that case.
  title_ar            String @default("")
  content_ar          String @default("")
  meta_description_ar String @default("")

  // Per-page hero banner — single image (no carousel/video/stats, those stay
  // homepage-only via PageBlock). Off by default so adding these columns
  // never changes an existing live page until an admin opts in.
  hero_enabled        Boolean @default(false)
  hero_badge          String  @default("")
  hero_headline       String  @default("")
  hero_subheadline    String  @default("")
  hero_align          String  @default("center")
  hero_image_url      String  @default("")
  hero_image_position String  @default("50% 50%")
  hero_image_zoom     Int     @default(100)
  hero_overlay        Boolean @default(true)
  hero_cta_label      String  @default("")
  hero_cta_href       String  @default("")

  hero_badge_ar       String @default("")
  hero_headline_ar    String @default("")
  hero_subheadline_ar String @default("")
  hero_cta_label_ar   String @default("")

  // Per-locale translations, e.g. { "fr": { "title": "...", "content": "...",
  // "meta_description": "...", "hero_badge": "...", ... } }. Supersedes the
  // *_ar columns above.
  translations Json @default("{}")

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("pages")
  @@schema("lms")
}

model BlogPost {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  excerpt         String    @default("")
  content         String    @default("")
  title_ar        String    @default("")
  excerpt_ar      String    @default("")
  content_ar      String    @default("")
  // Per-locale translations, e.g. { "fr": { "title": "...", "excerpt": "...", "content": "..." } }.
  // Supersedes the *_ar columns above (kept only so existing Arabic data
  // isn't lost until the migration script copies it in) — new languages
  // only ever touch this column, never require a schema change.
  translations    Json      @default("{}")
  cover_image_url String    @default("")
  category        String    @default("")
  tags            String[]  @default([])
  author_name     String    @default("")
  author_avatar   String    @default("")
  reading_time    String    @default("")
  is_published    Boolean   @default(false)
  is_featured     Boolean   @default(false)
  published_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("blog_posts")
  @@schema("lms")
}

// Captured from the blog post reading-page popup (and any future lead
// magnet). Upserted by email — a repeat visit updates source/page_url
// rather than creating a duplicate row, so the admin list stays one row
// per real person.
model Lead {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String   @default("")
  interest   String   @default("") // which "What are you interested in?" option they picked
  source     String   @default("") // e.g. "blog" — where the capture happened
  page_url   String   @default("")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("leads")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model Event {
  id                String       @id @default(uuid())
  slug              String       @unique
  title             String
  subtitle          String?
  summary           String?
  description       String?      @db.Text
  cover_image_url   String?
  promo_video_url   String?
  event_nature      EventNature?
  event_type        EventType    @default(online)
  city              String?
  location_address  String?
  meeting_link      String?
  meeting_platform  MeetingPlatform?
  timezone          String       @default("America/Toronto")
  start_at          DateTime
  end_at            DateTime
  price             Decimal      @db.Decimal(10, 2) @default(0)
  currency          String       @default("usd")
  capacity          Int?
  status            EventStatus  @default(draft)
  speakers          Json?
  agenda            Json?
  topics            String[]     @default([])
  is_featured       Boolean      @default(false)

  // Per-locale translations, e.g. { "fr": { "title": "...", "summary": "...",
  // "agenda": [...] } }. Same shape/mechanism as Certification.translations —
  // see common/utils/localize.ts. Speaker bios are deliberately not
  // translated (mirrors Certification/Program skipping testimonials, to
  // avoid running real people's names through the AI translator).
  translations      Json         @default("{}")

  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  registrations EventRegistration[]

  @@index([slug])
  @@index([status])
  @@map("events")
  @@schema("lms")
}

model EventRegistration {
  id     String @id @default(uuid())
  event_id String
  event    Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id  String?
  user     User?  @relation(fields: [user_id], references: [id], onDelete: SetNull)

  name  String
  email String
  phone String?

  address_line1    String?
  city             String?
  state_province   String?
  postal_code      String?
  country          String?
  profession       String?
  job_title        String?
  education        String?
  years_experience Int?

  status       EventRegistrationStatus @default(registered)
  amount_paid  Decimal                 @db.Decimal(10, 2) @default(0)
  stripe_payment_intent_id   String?
  stripe_checkout_session_id String?
  stripe_receipt_url         String?
  registered_at DateTime @default(now())

  @@unique([event_id, email])
  @@index([event_id])
  @@map("event_registrations")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// ONLINE TOOLS
// ─────────────────────────────────────────────

model OnlineTool {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  tagline           String?
  offered_by        String?
  tool_type         String   @default("course")   // course | bundle | subscription | external
  price             Decimal  @db.Decimal(10, 2) @default(0)
  member_price      Decimal? @db.Decimal(10, 2)
  billing_type      String   @default("one_time") // one_time | monthly | annual | free
  short_description String?
  overview          String?
  thumbnail_url     String?
  badge_text        String?
  cta_label         String   @default("Add To Cart")
  cta_url           String?
  features          Json     @default("[]")       // [{title,description}]
  how_it_works      Json     @default("[]")       // [{title,description}]
  status            String   @default("draft")    // draft | active | archived
  sort_order        Int      @default(0)
  course_id         String?
  certification_id  String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("online_tools")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// PROMO CODES
// ─────────────────────────────────────────────

model PromoCode {
  id               String   @id @default(uuid())
  code             String   @unique
  description      String?
  discount_type    String   // "percentage" | "fixed"
  discount_value   Decimal  @db.Decimal(10, 2)
  max_uses         Int?
  max_uses_per_user Int?
  used_count       Int      @default(0)
  expires_at       DateTime?
  is_active        Boolean  @default(true)
  // Empty array = unrestricted on that dimension. A code with both non-empty
  // is valid for an order matching ANY listed course OR ANY listed cert (OR
  // semantics, not AND) — see PromoCodesService.validate(). Plain Postgres
  // arrays rather than a join table, matching this schema's existing
  // convention for "multiple loosely-related IDs" (see Certification.
  // related_slugs, skills, tags).
  course_ids        String[] @default([])
  certification_ids String[] @default([])
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  redemptions      PromoRedemption[]

  @@map("promo_codes")
  @@schema("lms")
}

model PromoRedemption {
  id           String    @id @default(uuid())
  promo_id     String
  promo        PromoCode @relation(fields: [promo_id], references: [id], onDelete: Cascade)
  user_id      String
  redeemed_at  DateTime  @default(now())

  @@index([promo_id, user_id])
  @@map("promo_redemptions")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// ORGANIZATION / CORPORATE ACCOUNTS
// ─────────────────────────────────────────────

// A corporate/group customer account. Always provisioned by PAII staff
// (via the internal admin app) after a sales conversation — no
// self-signup. Seats are set here by staff, not self-purchased in-portal.
model Organization {
  id              String   @id @default(uuid())
  name            String
  contact_email   String
  seats_purchased Int      @default(0)
  notes           String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Self-service billing. Null price = self-service billing is disabled for
  // this org (PAII staff still manages seats/expiry manually, exactly as
  // before this feature existed) — set by staff per org, matching that
  // different orgs may have negotiated different per-seat deals.
  price_per_seat          Decimal?  @db.Decimal(10, 2)
  renewal_period_months   Int       @default(12)
  // Null = no expiration enforced (legacy/comped orgs). Only set once an
  // org actually completes a paid renewal. Only gates new employee invites
  // when in the past — never revokes already-enrolled employees' access.
  subscription_expires_at DateTime?

  // Self-service employee sign-up link (org.paii.ca/join/<token>) — lazily
  // generated on first request, regeneratable to invalidate a leaked link.
  invite_token String? @unique

  admins      OrganizationAdmin[]
  enrollments Enrollment[]
  program_enrollments ProgramEnrollment[]
  payments    Payment[]
  users_last_here User[] @relation("UserLastOrganization")
  removal_logs OrganizationRemovalLog[]

  @@map("organizations")
  @@schema("lms")
}

// A standing record of every employee an org admin has removed — enrollment
// rows are hard-deleted on removal (and the account itself if it was never
// verified), so without this, PAII staff would have no way to see churn.
// Lets staff spot abnormal patterns (e.g. many adds/removes cycling through
// more people than the org has paid seats for) on the org detail page.
model OrganizationRemovalLog {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  email           String
  full_name       String?
  account_deleted Boolean
  removed_at      DateTime     @default(now())

  @@index([organization_id])
  @@map("organization_removal_logs")
  @@schema("lms")
}

// Mirrors AffiliateProfile's shape: an ordinary User (role stays
// `student`) gains a capability via an attached profile row rather than
// a new Role enum value, since org-admin is a narrow capability that
// would otherwise ripple into every @Roles(...) guard check.
model OrganizationAdmin {
  id              String       @id @default(uuid())
  user_id         String       @unique
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_at      DateTime     @default(now())

  @@map("organization_admins")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// AFFILIATE / SALES REP
// ─────────────────────────────────────────────

model AffiliateProfile {
  id               String          @id @default(uuid())
  user_id          String          @unique
  user             User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  referral_code    String          @unique
  commission_rate  Decimal         @db.Decimal(5, 2) @default(10)
  status           AffiliateStatus @default(pending)
  payout_method    String?
  payout_details   String?
  notes            String?
  approved_at      DateTime?
  approved_by      String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  product_assignments AffiliateProductAssignment[]
  leads               AffiliateLead[]
  commissions         AffiliateCommission[]
  promo_codes         AffiliatePromoCode[]
  invites             AffiliateInvite[]

  @@map("affiliate_profiles")
  @@schema("lms")
}

model AffiliateProductAssignment {
  id                  String           @id @default(uuid())
  affiliate_id        String
  affiliate           AffiliateProfile @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  certification_id    String?
  certification       Certification?   @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  course_id           String?
  course              Course?          @relation(fields: [course_id], references: [id], onDelete: Cascade)
  commission_override Decimal?         @db.Decimal(5, 2)
  assigned_at         DateTime         @default(now())

  @@index([affiliate_id])
  @@map("affiliate_product_assignments")
  @@schema("lms")
}

model AffiliatePromoCode {
  id               String              @id @default(uuid())
  affiliate_id     String
  affiliate        AffiliateProfile    @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  code             String              @unique
  discount_type    String              @default("percentage")
  discount_value   Decimal             @db.Decimal(10, 2)
  description      String?
  min_order_value  Decimal?            @db.Decimal(10, 2)
  is_stackable     Boolean             @default(false)
  expires_at       DateTime?
  max_uses         Int?
  uses_count       Int                 @default(0)
  is_active        Boolean             @default(true)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  @@index([affiliate_id])
  @@map("affiliate_promo_codes")
  @@schema("lms")
}

model AffiliateLead {
  id               String              @id @default(uuid())
  affiliate_id     String
  affiliate        AffiliateProfile    @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  certification_id String?
  certification    Certification?      @relation(fields: [certification_id], references: [id], onDelete: SetNull)
  course_id        String?
  course           Course?             @relation(fields: [course_id], references: [id], onDelete: SetNull)
  email            String
  name             String?
  source           String?
  status           AffiliateLeadStatus @default(invited)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  // Set once, at email verification, from the referred visitor's own account —
  // a permanent link that survives them later using a different email on an
  // application form. `email` is kept as a fallback match for leads created
  // before this field existed. Cascades on delete: an admin deleting the
  // underlying user should remove the lead too, not leave a stale row
  // (with its own cached email/name) still showing on the leads page.
  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  commissions AffiliateCommission[]

  @@index([affiliate_id])
  @@index([user_id])
  @@map("affiliate_leads")
  @@schema("lms")
}

model AffiliateCommission {
  id               String                    @id @default(uuid())
  affiliate_id     String
  affiliate        AffiliateProfile          @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  user_id          String?
  user             User?                     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  lead_id          String?
  lead             AffiliateLead?            @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  certification_id String?
  certification    Certification?            @relation(fields: [certification_id], references: [id], onDelete: SetNull)
  course_id        String?
  course           Course?                   @relation(fields: [course_id], references: [id], onDelete: SetNull)
  sale_amount      Decimal                   @db.Decimal(10, 2)
  amount           Decimal                   @db.Decimal(10, 2)
  commission_rate  Decimal                   @db.Decimal(5, 2)
  // The promo code that triggered this commission, if any (vs. a plain
  // referral-link lead). Recorded at creation time since nothing else on
  // this record can be joined back to the checkout that produced it.
  promo_code       String?
  // Correlates back to the Payment that generated this commission (Payment.
  // stripe_payment_intent_id is unique) — lets a refund find and void it.
  stripe_payment_intent_id String?              @unique
  status           AffiliateCommissionStatus @default(pending)
  paid_at          DateTime?
  voided_at        DateTime?
  void_reason      String?
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt

  @@index([affiliate_id, status])
  @@index([user_id, certification_id])
  @@map("affiliate_commissions")
  @@schema("lms")
}

model AffiliateInvite {
  id           String                @id @default(uuid())
  affiliate_id String
  affiliate    AffiliateProfile      @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)
  email        String
  name         String?
  status       AffiliateInviteStatus @default(pending)
  created_at   DateTime              @default(now())
  updated_at   DateTime              @updatedAt

  @@index([affiliate_id])
  @@map("affiliate_invites")
  @@schema("lms")
}

// ─────────────────────────────────────────────
// PROGRAMS — admin-curated bundles of existing Courses + a Capstone,
// sold at their own price. Deliberately independent of the
// Certification/Application/Exam/Certificate pipeline: a Program's
// completion credential (ProgramCertificate) is a simpler, separate
// credential, auto-issued (no admin review) once every required course
// is completed and the capstone is passed. References existing Course
// rows via ProgramCourse rather than duplicating any course content.
// ─────────────────────────────────────────────

enum ProgramStatus {
  draft
  published
  archived

  @@schema("lms")
}

enum ProgramEnrollmentStatus {
  active
  completed
  suspended

  @@schema("lms")
}

model Program {
  id                String        @id @default(uuid())
  slug              String        @unique
  title             String
  code              String?
  short_description String?
  description       String?       @db.Text
  overview          String?       @db.Text

  learning_outcomes String[] @default([])
  target_audience   String[] @default([])
  prerequisites     String[] @default([])
  related_slugs     String[] @default([])   // cross-sell — other Program slugs, mirrors Certification.related_slugs

  duration_weeks    Int?
  estimated_hours   Decimal?     @db.Decimal(5, 1)
  level             CourseLevel  @default(beginner)
  thumbnail_url     String?

  status            ProgramStatus @default(draft)
  price             Decimal       @db.Decimal(10, 2) @default(0)
  currency          String        @default("USD")
  is_featured       Boolean       @default(false)
  faqs_json         Json          @default("[]")   // [{question, answer}]
  testimonials      Json          @default("[]")   // [{quote, name, role, company, avatar_initials}]
  marketing_meta    Json          @default("{}")   // {reviews_rating, reviews_count, social_proof, hero_badge_label, enrollment_includes[], certificate_template_html}

  // Per-locale translations, e.g. { "fr": { "title": "...", "description": "...",
  // "faqs_json": [...], "marketing_meta": {...} } }. Same shape/mechanism as
  // Certification.translations — see common/utils/localize.ts.
  translations Json @default("{}")

  enrollment_type       String?    // e.g. "open", "cohort" — free text, kept flexible
  enrollment_start_date DateTime?
  enrollment_end_date   DateTime?
  max_learners          Int?
  access_duration_days  Int?       // null = lifetime access
  allow_individual_course_purchase Boolean @default(true)

  director_user_id String?
  director          User?    @relation("ProgramDirector", fields: [director_user_id], references: [id], onDelete: SetNull)

  // This Program's own completion credential — intentionally NOT a link to
  // the existing Certification model (see header comment above).
  certificate_title       String?
  certificate_description String?

  created_by String?
  creator    User?    @relation("ProgramCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  courses     ProgramCourse[]
  enrollments ProgramEnrollment[]
  certificates ProgramCertificate[]
  instructors ProgramInstructor[]
  recommendations ProgramRecommendation[]
  transcripts Transcript[]

  @@index([slug])
  @@index([status])
  @@map("programs")
  @@schema("lms")
}

// Instructor assignment to a Program — mirrors CourseInstructor (used by
// Certification) so the "Your Instructors" section on the Program landing
// page follows the same pattern.
model ProgramInstructor {
  id         String   @id @default(uuid())
  program_id String
  program    Program  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation("ProgramInstructor", fields: [user_id], references: [id], onDelete: Cascade)
  is_lead    Boolean  @default(false)
  assigned_at DateTime @default(now())

  @@unique([program_id, user_id])
  @@map("program_instructors")
  @@schema("lms")
}

// A bundled course can double as the program's capstone (is_capstone) —
// deliberately just a regular Course (built/graded/submitted-to via the
// exact same module/lesson/assignment infrastructure every other course
// uses, kept out of the public catalog via Course.is_listed = false) rather
// than a bespoke capstone entity. The capstone_* fields below are optional
// descriptive metadata (rubric, deliverables, etc.) shown alongside that
// course — they don't gate anything; program completion is driven purely by
// "all required ProgramCourse rows (including the capstone course) have a
// completed CourseEnrollment", same as any other required course.
model ProgramCourse {
  id          String   @id @default(uuid())
  program_id  String
  program     Program  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  course_id   String
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  sort_order  Int      @default(0)
  is_required Boolean  @default(true)
  created_at  DateTime @default(now())

  // A bundled course can be flagged as the program's capstone or internship
  // placement — still a real Course underneath (module/lesson/assignment
  // infrastructure, its own submission + grading UI), just kept out of the
  // public catalog and gated to this program's enrolled students (see
  // canViewPrivateCourse in prep-courses.service.ts). special_metadata's
  // shape depends on special_type:
  //   capstone:   { rubric_json, deliverables[], learning_objectives[], submission_requirements, passing_score }
  //   internship: { host_organization, supervisor_name, supervisor_email, hours_required, evaluation_criteria[], report_requirements, passing_score }
  special_type     ProgramCourseSpecialType?
  special_metadata Json                      @default("{}")

  @@unique([program_id, course_id])
  @@index([program_id, sort_order])
  @@map("program_courses")
  @@schema("lms")
}

enum ProgramCourseSpecialType {
  capstone
  internship

  @@schema("lms")
}

model ProgramEnrollment {
  id         String  @id @default(uuid())
  program_id String
  program    Program @relation(fields: [program_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  status              ProgramEnrollmentStatus @default(active)
  progress_percentage Int                     @default(0)

  enrolled_at       DateTime  @default(now())
  completed_at      DateTime?
  access_expires_at DateTime?

  stripe_payment_intent_id String?
  amount_paid              Decimal? @db.Decimal(10, 2)

  // Set when this enrollment came from an org's bulk employee invite
  // (mirrors Enrollment.organization_id for Certifications) — draws from
  // the same org-wide seat pool.
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  certificate ProgramCertificate?
  course_waivers ProgramCourseWaiver[]
  transcripts Transcript[]

  @@unique([user_id, program_id])
  @@index([program_id, status])
  @@map("program_enrollments")
  @@schema("lms")
}

// Exempts a student from an individual required course in a program's
// sequence — mirrors EnrollmentCourseWaiver (used for Certifications).
// Waived courses count as "satisfied" for both the sequential-unlock gate
// and the overall completion check, without requiring an actual
// CourseEnrollment.completed_at.
model ProgramCourseWaiver {
  id                     String            @id @default(uuid())
  program_enrollment_id  String
  program_enrollment     ProgramEnrollment @relation(fields: [program_enrollment_id], references: [id], onDelete: Cascade)
  course_id              String
  course                 Course            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  reason                 String?           @db.Text
  waived_by              String
  waived_by_user         User              @relation("ProgramCourseWaiverGrantedBy", fields: [waived_by], references: [id])
  waived_at              DateTime          @default(now())

  @@unique([program_enrollment_id, course_id])
  @@map("program_course_waivers")
  @@schema("lms")
}

// A professor recommending a Program to a student — purely informational
// (no accept/reject state), mirrors CertificationRecommendation.
model ProgramRecommendation {
  id           String   @id @default(uuid())
  professor_id String
  professor    User     @relation("ProgramRecommendationsSent", fields: [professor_id], references: [id], onDelete: Cascade)
  student_id   String
  student      User     @relation("ProgramRecommendationsReceived", fields: [student_id], references: [id], onDelete: Cascade)
  program_id   String
  program      Program  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([professor_id, student_id, program_id])
  @@map("program_recommendations")
  @@schema("lms")
}

enum ProgramCertificateStatus {
  active
  revoked

  @@schema("lms")
}

// A Program's own completion credential — deliberately separate from the
// accredited Certificate model (see section header comment above).
model ProgramCertificate {
  id                    String            @id @default(uuid())
  program_id            String
  program               Program           @relation(fields: [program_id], references: [id], onDelete: Cascade)
  program_enrollment_id String            @unique
  program_enrollment    ProgramEnrollment @relation(fields: [program_enrollment_id], references: [id], onDelete: Cascade)
  user_id               String
  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  certificate_number String   @unique
  title              String   // snapshot of Program.certificate_title at issuance time
  issued_at          DateTime @default(now())
  verification_url   String?  // public /verify?id=<certificate_number> link, same pattern as Certificate

  status             ProgramCertificateStatus @default(active)
  revoked_at         DateTime?
  revocation_reason  String?

  @@map("program_certificates")
  @@schema("lms")
}

// A stable *identity* for a student's academic record in a program — NOT a
// snapshot of grades. All academic content (course grades, hours, GPA,
// standing) is computed live from CourseEnrollment/AssignmentSubmission/
// ProgramEnrollment every time the transcript is viewed, so an admin's grade
// correction after issuance is reflected immediately without any sync logic.
// Lazily created on first request for a given (user, program) pair.
model Transcript {
  id                    String            @id @default(uuid())
  transcript_number     String            @unique
  user_id               String
  user                  User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  program_id            String
  program               Program           @relation(fields: [program_id], references: [id], onDelete: Cascade)
  program_enrollment_id String
  program_enrollment    ProgramEnrollment @relation(fields: [program_enrollment_id], references: [id], onDelete: Cascade)
  issued_at             DateTime          @default(now())
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  shares TranscriptShare[]

  @@unique([user_id, program_id])
  @@map("transcripts")
  @@schema("lms")
}

enum TranscriptShareStatus {
  active
  revoked

  @@schema("lms")
}

// One row per share link — supports multiple concurrent/historical shares
// per transcript (the student's "Manage Sharing" list), each independently
// revocable. expires_at is nullable/unused today (every share defaults to
// never-expiring) but present so link expiration can be added later without
// another migration.
model TranscriptShare {
  id                String                @id @default(uuid())
  transcript_id     String
  transcript        Transcript            @relation(fields: [transcript_id], references: [id], onDelete: Cascade)
  token             String                @unique
  status            TranscriptShareStatus @default(active)
  created_at        DateTime              @default(now())
  expires_at        DateTime?
  revoked_at        DateTime?
  revocation_reason String?

  @@map("transcript_shares")
  @@schema("lms")
}
